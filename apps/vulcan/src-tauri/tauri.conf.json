{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vulcan",
  "version": "0.1.0",
  "identifier": "dev.wuguishifu.vulcan",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "nx dev vulcan",
    "beforeBuildCommand": "nx build vulcan"
  },
  "app": {
    "windows": [
      {
        "title": "Vulcan",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/whisper-cli"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
